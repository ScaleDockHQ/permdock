{
  "name": "@permdock/ox-config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Oxlint and Oxfmt configuration for the PermDock monorepo.",
  "license": "MIT",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    "./oxlint": "./src/oxlint.ts",
    "./oxfmt": "./src/oxfmt.ts"
  },
  "scripts": {
    "lint": "oxlint --disable-nested-config",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --checkers 4"
  },
  "dependencies": {
    "@oxlint/plugins": "catalog:",
    "@shadcn/lint": "catalog:",
    "eslint-plugin-playwright": "catalog:",
    "eslint-plugin-turbo": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-plugin-react-doctor": "catalog:",
    "oxlint-tsgolint": "catalog:"
  },
  "devDependencies": {
    "@permdock/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
