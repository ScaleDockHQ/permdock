{
  "name": "@permdock/cli",
  "version": "0.1.0",
  "description": "Collect, catalog, usage, openapi, rls, doctor and skills for PermDock. Collect-only build hooks for Next.js and unplugin bundlers.",
  "keywords": [
    "catalog",
    "cli",
    "openapi",
    "permdock",
    "rls"
  ],
  "homepage": "https://permdock.dev",
  "bugs": {
    "url": "https://github.com/ScaleDockHQ/PermDock/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScaleDockHQ/PermDock.git",
    "directory": "packages/cli"
  },
  "bin": {
    "permdock": "./dist/bin.js"
  },
  "files": [
    "dist",
    "schemas",
    "rulesets",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./unplugin": {
      "types": "./dist/unplugin.d.ts",
      "default": "./dist/unplugin.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "check:publish": "publint && pnpm pack --out pack.tgz && attw --profile esm-only pack.tgz && rm -f pack.tgz",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "oxc-parser": "catalog:",
    "pgsql-parser": "catalog:",
    "unplugin": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@permdock/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "permdock": "workspace:*",
    "pg": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "permdock": "catalog:peers",
    "pg": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
