{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://permdock.com/schemas/cli-commands-v1.json",
  "title": "PermDock CLI commands v1",
  "description": "What `permdock --help --json` prints: every command with its flags, positionals, side effects and docs page, read from the same manifest the parser uses. `permdock <command> --help --json` prints one `command`. Fields are only added within v1.",
  "type": "object",
  "required": ["$schema", "version", "globalFlags", "commands"],
  "properties": {
    "$schema": {
      "const": "https://permdock.com/schemas/cli-commands-v1.json"
    },
    "version": {
      "type": "string",
      "description": "The installed permdock version."
    },
    "globalFlags": {
      "type": "array",
      "items": { "$ref": "#/$defs/flag" }
    },
    "commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/command" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "command": {
      "type": "object",
      "required": [
        "path",
        "summary",
        "docs",
        "effects",
        "config",
        "positionals",
        "flags",
        "examples"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "The words after `permdock`, such as `rls generate`."
        },
        "summary": { "type": "string" },
        "docs": { "type": "string", "format": "uri" },
        "effects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "files",
              "rewrite",
              "database:read",
              "database:write",
              "network",
              "cloud:write",
              "install"
            ]
          },
          "description": "What the command may change. Empty means it only reads and prints. In agent mode, `rewrite`, `cloud:write`, and `files` with `--force` need a `--confirm` token."
        },
        "config": {
          "type": "boolean",
          "description": "Whether the command reads permdock.config.ts."
        },
        "positionals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "description", "required", "variadic"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "required": { "type": "boolean" },
              "variadic": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "flags": {
          "type": "array",
          "items": { "$ref": "#/$defs/flag" }
        },
        "examples": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "flag": {
      "type": "object",
      "required": ["name", "type", "description"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Written `--<name>` on the command line."
        },
        "type": { "enum": ["boolean", "string", "enum"] },
        "description": { "type": "string" },
        "alias": { "type": "string", "pattern": "^[a-z]$" },
        "options": { "type": "array", "items": { "type": "string" } },
        "default": { "type": ["boolean", "string"] },
        "repeatable": { "const": true },
        "valueHint": { "type": "string" },
        "secret": {
          "const": true,
          "description": "The value is a secret: pass it through stdin with `stdinFlag` or the `env` variable, never in argv."
        },
        "stdinFlag": { "type": "string" },
        "env": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
