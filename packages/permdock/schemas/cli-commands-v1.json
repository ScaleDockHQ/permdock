{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://permdock.com/schemas/cli-commands-v1.json",
  "title": "PermDock CLI commands v1",
  "description": "What `permdock --help --json` prints: every command with its arguments, options, examples, side effects and docs page, read from the same manifest the parser uses. `permdock <command> --help --json` prints the same document with that command only. The shape follows better-supabase's `cli-commands-v1`; `docs` and `config` are PermDock's own. Fields are only added within v1.",
  "type": "object",
  "required": ["$schema", "name", "version", "options", "commands"],
  "properties": {
    "$schema": {
      "const": "https://permdock.com/schemas/cli-commands-v1.json"
    },
    "name": {
      "const": "permdock"
    },
    "version": {
      "type": "string",
      "description": "The installed permdock version."
    },
    "options": {
      "description": "The global options every command accepts.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/option"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "command": {
      "type": "object",
      "required": [
        "name",
        "path",
        "description",
        "docs",
        "examples",
        "effects",
        "config",
        "arguments",
        "options"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "The last word of `path`."
        },
        "path": {
          "type": "string",
          "description": "The words after `permdock`, such as `rls generate`."
        },
        "description": {
          "type": "string"
        },
        "docs": {
          "type": "string",
          "format": "uri"
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Complete command lines, starting with `permdock`."
        },
        "effects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "files",
              "rewrite",
              "database:read",
              "database:write",
              "network",
              "cloud:write",
              "install"
            ]
          },
          "description": "What the command may change. Empty means it only reads and prints. In agent mode, `rewrite`, `cloud:write`, and `files` with `--force` need a `--confirm` token."
        },
        "config": {
          "type": "boolean",
          "description": "Whether the command reads permdock.config.ts."
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "description", "required", "variadic"],
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "variadic": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          }
        }
      },
      "additionalProperties": false
    },
    "option": {
      "type": "object",
      "required": ["name", "type", "description"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Written `--<name>` on the command line."
        },
        "type": {
          "enum": ["boolean", "string", "enum"]
        },
        "description": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]$"
          }
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "default": {
          "type": ["boolean", "string"]
        },
        "list": {
          "const": true,
          "description": "Takes several values, repeated."
        },
        "valueHint": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
