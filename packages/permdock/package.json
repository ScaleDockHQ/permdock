{
  "name": "permdock",
  "version": "0.0.0",
  "description": "Typed permissions for TypeScript apps, APIs, databases, and AI agents.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./approvals": {
      "types": "./dist/approvals/index.d.ts",
      "default": "./dist/approvals/index.js"
    },
    "./jwt": {
      "types": "./dist/jwt/index.d.ts",
      "default": "./dist/jwt/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check:publish": "publint && pnpm pack --out pack.tgz && attw --profile esm-only pack.tgz && rm -f pack.tgz",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@permdock/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "arktype": "catalog:",
    "jose": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "jose": "catalog:"
  },
  "peerDependenciesMeta": {
    "jose": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
