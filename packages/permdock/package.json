{
  "name": "permdock",
  "version": "0.0.0",
  "description": "Typed permissions for TypeScript apps, APIs, databases, and AI agents.",
  "license": "MIT",
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./approvals": {
      "types": "./dist/approvals/index.d.ts",
      "default": "./dist/approvals/index.js"
    },
    "./jwt": {
      "types": "./dist/jwt/index.d.ts",
      "default": "./dist/jwt/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react-native": {
      "types": "./dist/react-native/index.d.ts",
      "default": "./dist/react-native/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./next/plugin": {
      "types": "./dist/next/plugin.d.ts",
      "default": "./dist/next/plugin.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./hono": {
      "types": "./dist/hono/index.d.ts",
      "default": "./dist/hono/index.js"
    },
    "./express": {
      "types": "./dist/express/index.d.ts",
      "default": "./dist/express/index.js"
    },
    "./fastify": {
      "types": "./dist/fastify/index.d.ts",
      "default": "./dist/fastify/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk/index.d.ts",
      "default": "./dist/ai-sdk/index.js"
    },
    "./claude-agent": {
      "types": "./dist/claude-agent/index.d.ts",
      "default": "./dist/claude-agent/index.js"
    },
    "./eve": {
      "types": "./dist/eve/index.d.ts",
      "default": "./dist/eve/index.js"
    },
    "./openai": {
      "types": "./dist/openai/index.d.ts",
      "default": "./dist/openai/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./authzen": {
      "types": "./dist/authzen/index.d.ts",
      "default": "./dist/authzen/index.js"
    },
    "./openapi": {
      "types": "./dist/openapi/index.d.ts",
      "default": "./dist/openapi/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check:publish": "publint && pnpm pack --out pack.tgz && attw --profile esm-only pack.tgz && rm -f pack.tgz",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@permdock/typescript-config": "workspace:*",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "arktype": "catalog:",
    "express": "catalog:",
    "fastify": "catalog:",
    "hono": "catalog:",
    "jose": "catalog:",
    "next": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@openai/agents": "catalog:",
    "ai": "catalog:",
    "eve": "catalog:",
    "express": "catalog:",
    "fastify": "catalog:",
    "hono": "catalog:",
    "jose": "catalog:",
    "next": "catalog:",
    "react": "catalog:"
  },
