"// @generated by permdock generate test@0.0.0 from policy.ts sha-256:digest; do not edit

import type { Membership, Principal } from "permdock";
import type { FactoryRef } from "permdock/testing";
import type { EdgeRow, PlainRow } from "./types.ts";
import type { ScopeName } from "./constants.ts";
import { factoryText, factoryUuid, sequence } from "permdock/testing";
export { resetFactories } from "permdock/testing";

export type FactorySubject = Principal & {
  readonly roles: readonly (string)[];
  readonly memberships: readonly (Membership & { readonly scope: ScopeName })[];
};

export const subjectFactory = (input: Partial<FactorySubject> = {}): FactorySubject => ({ id: factoryUuid(), roles: [], memberships: [], ...input });

export const edgeFactory = (overrides: Partial<EdgeRow> = {}): EdgeRow => ({ ...{ count: 1, ratio: 0.5, below: -3, capped: 0, rank: 0, site: \`https://example.com/\${String(sequence())}\`, mail: \`user\${String(sequence())}@example.com\`, day: "2026-01-01", code: factoryText("code", 0, 3), long: factoryText("long", 2, 255), list: [], loose: [], nested: {}, bare: { inner: factoryText("inner", 0, 255) }, empty: {}, either: factoryText("either", 0, 255), maybe: factoryText("maybe", 0, 255), maybeObject: {}, level: 1, "odd-key": factoryText("odd-key", 0, 255), anything: null }, ...overrides });

export const plainFactory = (overrides: Partial<PlainRow> = {}): PlainRow => ({ ...overrides });
"
`;

