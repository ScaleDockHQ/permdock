// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`gen emitters > fills required fields with valid values in factories 1`] = `
"// @generated by permdock gen; do not edit

import type { Principal } from "permdock";

let sequence = 0;

/** Restarts the ids and names, so a test reads the same rows on every run. */
export function resetFactories(): void {
  sequence = 0;
}

function next(): number {
  sequence += 1;
  return sequence;
}

function uuid(): string {
  return \`00000000-0000-4000-8000-\${String(next()).padStart(12, "0")}\`;
}

function text(field: string, min: number, max: number): string {
  return \`\${field}-\${String(next())}\`.padEnd(min, "x").slice(0, max);
}

type Ref = string | { readonly id: string };

function idOf(ref: Ref): string {
  return typeof ref === "string" ? ref : ref.id;
}

export type EdgeRow = { readonly count: number; readonly ratio: number; readonly below: number; readonly capped: number; readonly rank: number; readonly site: string; readonly between?: number; readonly positive?: number; readonly shape?: unknown; readonly stamp?: unknown; readonly mail: string; readonly day: string; readonly code: string; readonly long: string; readonly list: readonly (string)[]; readonly loose: readonly (unknown)[]; readonly nested: { readonly deep?: boolean }; readonly bare: { readonly inner: string }; readonly empty: {}; readonly either: unknown; readonly maybe: string | null; readonly maybeObject: { readonly a?: string } | null; readonly maybeList?: readonly (string)[] | null; readonly level: 1 | 2; readonly choice?: "a" | null; readonly "odd-key": string; readonly anything: unknown };

export type PlainRow = {};

export type FactoryMembership = {
  readonly scope: "tenant" | "odd-scope" | "global";
  readonly id: string;
  readonly roles: readonly (string)[];
};

export type FactorySubject = Principal & {
  readonly roles: readonly (string)[];
  readonly memberships: readonly FactoryMembership[];
};

export const factories = {
  edge: (overrides: Partial<EdgeRow> = {}): EdgeRow => ({ ...{ count: 1, ratio: 0.5, below: -3, capped: 0, rank: 0, site: \`https://example.com/\${String(next())}\`, mail: \`user\${String(next())}@example.com\`, day: "2026-01-01", code: text("code", 0, 3), long: text("long", 2, 255), list: [], loose: [], nested: {}, bare: { inner: text("inner", 0, 255) }, empty: {}, either: text("either", 0, 255), maybe: text("maybe", 0, 255), maybeObject: {}, level: 1, "odd-key": text("odd-key", 0, 255), anything: null }, ...overrides }),
  plain: (overrides: Partial<PlainRow> = {}): PlainRow => ({ ...overrides }),
  subject: (input: Partial<FactorySubject> = {}): FactorySubject => ({ id: uuid(), roles: [], memberships: [], ...input }),
};
"
`;

exports[`gen emitters > rejects two topics or buckets that build the same name 1`] = `
"// @generated by permdock gen; do not edit

export const scopes = [] as const;
export type ScopeName = (typeof scopes)[number];

export const roles = [] as const;
export type RoleName = (typeof roles)[number];

/** \`rls.realtime.topics\`: the channel names the realtime policies match. */
export const topics = {
  oddId: (params: { readonly "odd-id": string }): string => \`\${params["odd-id"]}\`,
} as const;

/** \`rls.storage.buckets\`: object paths that start with a scope id. */
export const paths = {
  files: (params: { readonly tenant: string; readonly name: string }): string => \`\${params.tenant}/\${params.name}\`,
  avatars: (params: { readonly tenant: string; readonly name: string }): string => \`\${params.tenant}/\${params.name}\`,
} as const;

/** The SQL helpers \`rls generate\` writes. */
export const sqlNames = {
  "schema": "app",
  "claims": {
    "tenant": "tenant_id",
    "role": "user_role"
  },
  "scopes": {},
  "resources": {}
} as const;
"
`;

