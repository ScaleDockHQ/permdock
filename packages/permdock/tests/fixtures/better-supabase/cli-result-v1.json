{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/better-supabase/schemas/cli-result-v1.json",
  "title": "better-supabase CLI result",
  "description": "The one document a better-supabase command prints on stdout under `--json`. `data` is the command result, `error` is RFC 9457 Problem Details when it failed, and `next` names the commands to run next.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "status"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "status": {
      "description": "`success` for exit code 0, `action_required` for exit code 3 (the user has to give an input, consent or log in), `error` otherwise.",
      "enum": ["success", "error", "action_required"]
    },
    "data": {
      "description": "The command result. Its shape depends on the command."
    },
    "error": {
      "$ref": "#/$defs/problem"
    },
    "next": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/next"
      }
    }
  },
  "$defs": {
    "problem": {
      "description": "RFC 9457 Problem Details. `type` links to the code on the CLI errors page.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "detail", "code", "exitCode"],
      "properties": {
        "type": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "code": {
          "enum": [
            "usage",
            "unknown_command",
            "unknown_flag",
            "invalid_value",
            "command_moved",
            "flag_renamed",
            "missing_value",
            "outside_root",
            "config_not_found",
            "config_invalid",
            "env_invalid",
            "not_found",
            "invalid_input",
            "dependency_missing",
            "database_unreachable",
            "supabase_cli_missing",
            "supabase_cli_failed",
            "network_error",
            "request_failed",
            "auth_required",
            "integrity_failed",
            "generator_failed",
            "check_failed",
            "file_conflict",
            "findings",
            "input_required",
            "consent_required",
            "cancelled",
            "failed",
            "internal"
          ]
        },
        "exitCode": {
          "type": "integer",
          "minimum": 1
        },
        "suggestion": {
          "description": "The closest command or option.",
          "type": "string"
        },
        "flag": {
          "description": "The flag that supplies the missing value.",
          "type": "string"
        },
        "issues": {
          "description": "One line per problem.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing": {
          "description": "The flags the run needs, for input_required.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "choices": {
          "description": "The values each missing flag takes, the suggested one first.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "token": {
          "description": "The value for --confirm once the user agrees, for consent_required.",
          "type": "string"
        }
      }
    },
    "next": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "when"],
      "properties": {
        "command": {
          "type": "string"
        },
        "when": {
          "type": "string"
        }
      }
    }
  }
}
