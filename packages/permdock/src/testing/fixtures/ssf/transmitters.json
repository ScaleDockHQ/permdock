        "jti": "01J8Z3K6Q9W2E5R7T1Y4U8I0OP",
        "iat": 1790000200,
        "sub_id": {
          "format": "complex",
          "user": {
            "format": "iss_sub",
            "iss": "https://acme.us.auth0.com/",
            "sub": "auth0|64f1c2b3a4d5e6f7a8b9c0d1"
