{
  "$schema": "https://permdock.com/schemas/supabase-manifest-v1.json",
  "version": 1,
  "hook": {
    "schema": "permdock",
    "function": "custom_access_token_hook",
    "out": "supabase/schemas/permdock/functions/custom_access_token_hook.sql",
    "activeFrom": {
      "appMetadata": "tenant_id"
    },
    "schemas": "pg-delta"
  },
  "helpers": {
    "schema": "permdock",
    "functions": [
      "permdock_has",
      "permitted_organization_ids",
      "member_organization_ids",
      "member_organization_ids_for",
      "permitted_team_ids",
      "member_team_ids",
      "member_team_ids_for",
      "permitted_customer_ids",
      "member_customer_ids",
      "member_customer_ids_for"
    ]
  },
  "tenantClaim": "tenant_id",
  "budget": {
    "bytes": 1024,
    "measure": "octet_length(roles::text) + octet_length(user_role::text) + octet_length(memberships::text) + octet_length(team_ids::text) + octet_length(attrs::text) + octet_length(active_tenant::text) + 20 + octet_length(authz_ver::text)"
  },
  "claims": [
    {
      "name": "user_role",
      "source": "permdock",
      "budget": false
    },
    {
      "name": "roles",
      "source": "permdock",
      "budget": true
    },
    {
      "name": "memberships",
      "source": "permdock",
      "budget": true
    },
    {
      "name": "memberships_truncated",
      "source": "permdock",
      "budget": false
    },
    {
      "name": "suspended_in",
      "source": "permdock",
      "budget": false
    },
    {
      "name": "tenant_id",
      "source": "permdock",
      "budget": false
    },
    {
      "name": "authz_ver",
      "source": "permdock",
      "budget": true
    },
    {
      "name": "datetime_preferences",
      "source": "public.datetime_preference_claims",
      "budget": false
    },
    {
      "name": "features",
      "source": "public.feature_claims",
      "budget": false
    }
  ],
  "authzVersion": true,
  "authzVersionBump": {
    "schema": "permdock",
    "function": "permdock_bump_authz_version_for",
    "args": "p_users uuid[]"
  },
  "memberships": [
    {
      "table": "public.organization_memberships",
      "user": {
        "column": "user_id"
      },
      "scope": {
        "value": "organization"
      },
      "id": {
        "column": "organization_id"
      },
      "role": {
        "column": "role"
      },
      "columns": ["user_id", "organization_id", "role"]
    },
    {
      "table": "public.contacts",
      "user": {
        "column": "user_id"
      },
      "scope": {
        "value": "customer"
      },
      "id": {
        "column": "customer_id"
      },
      "role": {
        "value": ["contact"]
      },
      "within": {
        "columns": {
          "organization": "organization_id"
        }
      },
      "via": {
        "value": "contact"
      },
      "columns": ["user_id", "customer_id", "organization_id"]
    }
  ],
  "rls": {
    "schema": "permdock",
    "mode": "database",
    "tenantClaim": "tenant_id",
    "scopes": [
      {
        "name": "organization",
        "type": "uuid"
      },
      {
        "name": "team",
        "type": "uuid",
        "within": "organization"
      },
      {
        "name": "customer",
        "type": "uuid",
        "within": "organization"
      }
    ],
    "helpers": [
      {
        "name": "permdock_has",
        "args": "p_grant text",
        "returns": "boolean",
        "execute": ["authenticated"]
      },
      {
        "name": "permitted_organization_ids",
        "args": "p_grant text",
        "returns": "setof uuid",
        "execute": ["authenticated"]
      },
      {
        "name": "member_organization_ids",
        "args": "",
        "returns": "setof uuid",
        "execute": ["authenticated"]
      },
      {
        "name": "member_organization_ids_for",
        "args": "p_user uuid",
        "returns": "setof uuid",
        "execute": ["supabase_auth_admin"]
      },
      {
        "name": "permitted_team_ids",
        "args": "p_grant text",
        "returns": "setof uuid",
        "execute": ["authenticated"]
      },
      {
        "name": "member_team_ids",
        "args": "",
        "returns": "setof uuid",
        "execute": ["authenticated"]
      },
      {
        "name": "member_team_ids_for",
        "args": "p_user uuid, p_active text",
        "returns": "setof uuid",
        "execute": ["supabase_auth_admin"]
      },
      {
        "name": "permitted_customer_ids",
        "args": "p_grant text",
        "returns": "setof uuid",
        "execute": ["authenticated"]
      },
      {
        "name": "member_customer_ids",
        "args": "",
        "returns": "setof uuid",
        "execute": ["authenticated"]
      },
      {
        "name": "member_customer_ids_for",
        "args": "p_user uuid",
        "returns": "setof uuid",
        "execute": ["supabase_auth_admin"]
      },
      {
        "name": "permdock_user_id",
        "args": "",
        "returns": "uuid",
        "execute": ["authenticated"]
      },
      {
        "name": "permdock_subject",
        "args": "",
        "returns": "jsonb",
        "execute": ["authenticated"]
      },
      {
        "name": "permdock_subject",
        "args": "p_tenant text",
        "returns": "jsonb",
        "execute": ["authenticated"]
      },
      {
        "name": "permdock_bootstrap_permissions",
        "args": "p_tenant text",
        "returns": "jsonb",
        "execute": ["authenticated"]
      },
      {
        "name": "permdock_api_key_allows",
        "args": "p_grant text",
        "returns": "boolean",
        "execute": ["authenticated"]
      },
      {
        "name": "permdock_actor_may_write",
        "args": "",
        "returns": "boolean",
        "execute": ["authenticated"]
      },
      {
        "name": "permdock_is_approver",
        "args": "p_approvers jsonb, p_tenant text, p_requester text, p_resource text",
        "returns": "boolean",
        "execute": ["authenticated"]
      },
      {
        "name": "permdock_approver_for_ids",
        "args": "",
        "returns": "setof uuid",
        "execute": ["authenticated"]
      },
      {
        "name": "permdock_has_for",
        "args": "p_user uuid, p_grant text",
        "returns": "boolean",
        "execute": []
      },
      {
        "name": "permitted_organization_ids_for",
        "args": "p_user uuid, p_grant text",
        "returns": "setof uuid",
        "execute": []
      },
      {
        "name": "permitted_team_ids_for",
        "args": "p_user uuid, p_grant text",
        "returns": "setof uuid",
        "execute": []
      },
      {
        "name": "permitted_customer_ids_for",
        "args": "p_user uuid, p_grant text",
        "returns": "setof uuid",
        "execute": []
      },
      {
        "name": "permitted_organization_permission_keys_for",
        "args": "p_user uuid, p_id uuid",
        "returns": "setof text",
        "execute": []
      },
      {
        "name": "permitted_team_permission_keys_for",
        "args": "p_user uuid, p_id uuid",
        "returns": "setof text",
        "execute": []
      },
      {
        "name": "permitted_customer_permission_keys_for",
        "args": "p_user uuid, p_id uuid",
        "returns": "setof text",
        "execute": []
      },
      {
        "name": "permitted_organization_users",
        "args": "p_permission text, p_id uuid",
        "returns": "setof uuid",
        "execute": []
      },
      {
        "name": "permitted_customer_users",
        "args": "p_permission text, p_id uuid",
        "returns": "setof uuid",
        "execute": []
      },
      {
        "name": "permdock_role_in",
        "args": "p_role text, p_tenant uuid",
        "returns": "boolean",
        "execute": []
      }
    ],
    "memberships": [
      {
        "table": "public.organization_memberships",
        "user": {
          "column": "user_id"
        },
        "scope": {
          "value": "organization"
        },
        "id": {
          "column": "organization_id"
        },
        "role": {
          "column": "role"
        },
        "columns": ["user_id", "organization_id", "role"]
      },
      {
        "table": "public.contacts",
        "user": {
          "column": "user_id"
        },
        "scope": {
          "value": "customer"
        },
        "id": {
          "column": "customer_id"
        },
        "role": {
          "value": ["contact"]
        },
        "within": {
          "columns": {
            "organization": "organization_id"
          }
        },
        "via": {
          "value": "contact"
        },
        "columns": ["user_id", "customer_id", "organization_id"]
      }
    ],
    "customRoles": true,
    "customRoleTenant": "organization_id",
    "roles": {
      "table": "permdock.user_roles",
      "user": {
        "column": "user_id"
      },
      "role": {
        "column": "role"
      }
    },
    "suspension": {
      "scopes": {
        "organization": {
          "table": "public.organizations",
          "id": "id",
          "status": "status",
          "active": ["active"]
        }
      }
    },
    "assignments": {
      "tables": ["better_supabase.invitations"]
    },
    "apiKeys": {
      "claim": "api_key",
      "scopes": "scopes",
      "tenant": "tenant",
      "roles": "roles",
      "serviceRoles": []
    },
    "tableReads": [
      {
        "table": "public.contacts",
        "share": "row",
        "rules": ["unknown"],
        "reason": "row level security is on and no permissive select policy applies to authenticated or public, so the table is not read through PostgREST by a signed-in role; inspect does not read grants, so a table grant is not checked"
      },
      {
        "table": "public.customers",
        "share": "row",
        "rules": ["unknown"],
        "reason": "row level security is on and no permissive select policy applies to authenticated or public, so the table is not read through PostgREST by a signed-in role; inspect does not read grants, so a table grant is not checked"
      },
      {
        "table": "public.datetime_preferences",
        "share": "row",
        "rules": ["owner"],
        "reason": "policy datetime_preferences_own_read in supabase/schemas/public/tables/datetime_preferences.sql is an owner rule: it calls auth.uid() and reads column user_id, so a row is read by the user it names, not by a tenant grant"
      },
      {
        "table": "public.organization_features",
        "share": "row",
        "rules": ["unknown"],
        "reason": "row level security is on and no permissive select policy applies to authenticated or public (policies: organization_features_auth_admin_read), so the table is not read through PostgREST by a signed-in role; inspect does not read grants, so a table grant is not checked"
      },
      {
        "table": "public.organization_memberships",
        "share": "row",
        "rules": ["owner", "restrictive"],
        "reason": "policy organization_memberships_read in supabase/schemas/public/tables/organization_memberships.sql is an owner rule: it calls auth.uid(), better_supabase.member_organization_ids() and reads column user_id, organization_id, so a row is read by the user it names, not by a tenant grant; restrictive policy bsb_tenant_scope_select in supabase/schemas/900_better_supabase_004_memberships.sql reads column organization_id, user_id, so the rows it hides differ per row, not per tenant"
      },
      {
        "table": "public.organizations",
        "share": "row",
        "rules": ["condition"],
        "reason": "policy organizations_public_read in supabase/schemas/public/tables/organizations.sql is a row condition: it calls none and reads no column, which no tenant check of permdock.permitted_organization_ids_by_permission covers"
      },
      {
        "table": "public.quote_overviews",
        "share": "tenant",
        "column": "organization_id",
        "permissions": ["quotes.list"]
      },
      {
        "table": "public.quotes",
        "share": "row",
        "rules": ["condition"],
        "reason": "policy quotes_select in supabase/schemas/public/policies/permdock.sql is a row condition: it calls permdock.permitted_organization_ids(), permdock.permitted_customer_ids(), permdock.permdock_api_key_allows(), permdock.member_customer_ids() and reads column organization_id, customer_id, which no tenant check of permdock.permitted_organization_ids_by_permission covers"
      },
      {
        "table": "public.role_permissions",
        "share": "row",
        "permissions": ["roles.manage"],
        "rules": ["condition"],
        "reason": "policy role_permissions_manage in supabase/schemas/public/tables/role_permissions.sql is a row condition: it calls permdock.permitted_organization_ids_by_permission() and reads column r.id, role_id, r.organization_id, which no tenant check of permdock.permitted_organization_ids_by_permission covers"
      },
      {
        "table": "public.roles",
        "share": "row",
        "rules": ["condition"],
        "reason": "policy roles_read_members in supabase/schemas/public/tables/roles.sql is a row condition: it calls permdock.member_organization_ids() and reads column organization_id, which no tenant check of permdock.permitted_organization_ids_by_permission covers"
      },
      {
        "table": "public.staff",
        "share": "row",
        "rules": ["form"],
        "reason": "policy staff_select in supabase/schemas/public/policies/permdock.sql uses permdock.permitted_organization_ids inside a larger expression, not as \"<column> in (select permdock.permitted_organization_ids('<key>'))\"; key staff.list: every grant of it is unconditional; key staff.read: every grant of it is unconditional"
      }
    ],
    "sharedFunctions": [
      {
        "function": "public.quotes_overview_payload",
        "tables": ["public.quote_overviews"],
        "permissions": ["quotes.list"]
      }
    ],
    "tenantPureHelpers": [
      {
        "name": "permdock.permdock_organization_has",
        "keyArgument": "p_grant",
        "keyPosition": 0,
        "tenantArgument": "p_tenant"
      },
      {
        "name": "permdock.permitted_organization_permission_keys",
        "keyArgument": "p_keys",
        "keyPosition": 1,
        "tenantArgument": "p_id"
      }
    ],
    "permissionFilters": [
      {
        "name": "permdock.permdock_organization_has_active",
        "keyPosition": 0
      },
      {
        "name": "permdock.permitted_organization_permission_keys_active",
        "keyPosition": 0
      }
    ]
  },
  "decidingColumns": [
    "public.contacts.customer_id",
    "public.contacts.organization_id",
    "public.contacts.user_id",
    "public.organization_memberships.organization_id",
    "public.organization_memberships.role",
    "public.organization_memberships.user_id"
  ],
  "markers": {
    "hook": "v1",
    "grants": "v1"
  },
  "requires": {
    "matrix": "capability-matrix-v1.12.0",
    "capabilities": [
      "auth.session.get_claims",
      "realtime.subscriptions.private_channel",
      "storage.file_buckets.download",
      "storage.file_buckets.list_files",
      "storage.file_buckets.move",
      "storage.file_buckets.remove",
      "storage.file_buckets.update_file",
      "storage.file_buckets.upload"
    ]
  },
  "names": {
    "schema": "permdock",
    "gucPrefix": "app",
    "claims": {
      "tenant": "tenant_id",
      "role": "user_role"
    },
    "teamScope": "team",
    "scopes": {
      "organization": {
        "permittedIds": "permitted_organization_ids",
        "permittedIdsFor": "permitted_organization_ids_for",
        "memberIds": "member_organization_ids",
        "memberIdsFor": "member_organization_ids_for",
        "permittedUsers": "permitted_organization_users"
      },
      "team": {
        "permittedIds": "permitted_team_ids",
        "permittedIdsFor": "permitted_team_ids_for",
        "memberIds": "member_team_ids",
        "memberIdsFor": "member_team_ids_for",
        "memberIdsOf": "member_team_ids_of",
        "permittedUsers": "permitted_team_users"
      },
      "customer": {
        "permittedIds": "permitted_customer_ids",
        "permittedIdsFor": "permitted_customer_ids_for",
        "memberIds": "member_customer_ids",
        "memberIdsFor": "member_customer_ids_for",
        "permittedUsers": "permitted_customer_users"
      }
    },
    "resources": {
      "staff": {
        "table": "staff"
      },
      "quotes": {
        "table": "quotes"
      }
    }
  },
  "fixtureRoles": ["admin", "member", "owner"],
  "managementApi": {
    "hook_custom_access_token_enabled": true,
    "hook_custom_access_token_uri": "pg-functions://postgres/permdock/custom_access_token_hook",
    "jwt_exp": 3600
  }
}
