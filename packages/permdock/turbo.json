{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tags": ["library"],
  "tasks": {
    "build": {
      "inputs": [
        "src/**",
        "schemas/**",
        "rulesets/**",
        "skills/**",
        "package.json",
        "tsconfig.json",
        "tsdown.config.ts"
      ]
    },
    "typecheck": {
      "dependsOn": ["build", "^build"]
    },
    "test": {
      "dependsOn": ["$TURBO_EXTENDS$", "build", "//#authzen:vectors"],
      "inputs": ["$TURBO_DEFAULT$", "tests/testing/fixtures/authzen/**"],
      "env": ["$TURBO_EXTENDS$", "CI", "PERMDOCK_COLLECT"]
    },
    "gen:check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/testing-fixtures.ts",
        "$TURBO_ROOT$/apps/examples/next-better-supabase/permissions.catalog.json",
        "$TURBO_ROOT$/apps/examples/next-better-supabase/permdock.manifest.json"
      ]
    }
  }
}
