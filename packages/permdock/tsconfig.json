{
  "extends": "@permdock/typescript-config/library.json",
  "compilerOptions": {
    "rootDir": "src",
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "next/cache": ["./node_modules/next/cache.d.ts"],
      "next/navigation": ["./node_modules/next/navigation.d.ts"],
      "next/server": ["./node_modules/next/server.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.test-d.ts",
    "src/fixtures/**",
    "src/cli/fixtures/**"
  ]
}
