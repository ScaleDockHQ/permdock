{
  "name": "@permdock/testing",
  "version": "0.2.0",
  "description": "Policy matrix tests, snapshot fixtures, RLS parity and extension-interface conformance runners for PermDock.",
  "keywords": [
    "permdock",
    "rls",
    "testing",
    "vitest"
  ],
  "homepage": "https://permdock.dev",
  "bugs": {
    "url": "https://github.com/ScaleDockHQ/PermDock/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScaleDockHQ/PermDock.git",
    "directory": "packages/testing"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./saas": {
      "types": "./dist/saas.d.ts",
      "default": "./dist/saas.js"
    },
    "./saas/permissions": {
      "types": "./dist/saas-permissions.d.ts",
      "default": "./dist/saas-permissions.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "check:publish": "publint && pnpm pack --out pack.tgz && attw --profile esm-only pack.tgz && rm -f pack.tgz",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@permdock/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jose": "catalog:",
    "permdock": "workspace:*",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "permdock": "catalog:peers",
    "vitest": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
