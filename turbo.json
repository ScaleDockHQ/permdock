{
  "$schema": "https://v2-10-12.turborepo.dev/schema.json",
  "futureFlags": {
    "globalConfiguration": true
  },
  "global": {
    "env": ["CI", "NODE_ENV"],
    "envMode": "strict",
    "inputs": ["tsconfig.json"],
    "passThroughEnv": [
      "COREPACK_HOME",
      "ENABLE_EXPERIMENTAL_COREPACK",
      "LEFTHOOK"
    ]
  },
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typegen": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": ["NEXT_E2E", "PERMDOCK_COLLECT", "PERMDOCK_E2E_DRIFT"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build", "^build"]
    },
    "check:publish": {
      "dependsOn": ["build", "^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
