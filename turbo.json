{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": true,
  "futureFlags": {
    "globalConfiguration": true,
    "affectedUsingTaskInputs": true,
    "filterUsingTasks": true,
    "watchUsingTaskInputs": true,
    "pruneIncludesGlobalFiles": true,
    "githubActionsRemoteBaseRefFallback": true,
    "errorsOnlyShowHash": true,
    "longerSignatureKey": true,
    "strictTaskEntrypointSelection": true
  },
  "global": {
    "envMode": "strict",
    "cacheMaxAge": "14d",
    "cacheMaxSize": "10GB",
    "remoteCache": {
      "enabled": true,
      "signature": true
    },
    "passThroughEnv": [
      "CI",
      "COREPACK_HOME",
      "ENABLE_EXPERIMENTAL_COREPACK",
      "GITHUB_ACTIONS",
      "INIT_CWD",
      "LEFTHOOK",
      "PORTLESS*",
      "REUI_LICENSE_KEY",
      "TURBO_REMOTE_CACHE_SIGNATURE_KEY",
      "VERCEL",
      "VERCEL_*"
    ],
    "inputs": [
      "packages/typescript-config/*.json",
      "packages/ox-config/src/**",
      "pnpm-workspace.yaml"
    ]
  },
  "boundaries": {
    "tags": {
      "library": {
        "dependencies": {
          "allow": ["library", "tooling"]
        }
      },
      "app": {
        "dependencies": {
          "allow": ["library", "tooling", "ui", "next-config"]
        }
      },
      "example": {
        "dependencies": {
          "allow": ["library", "tooling"]
        },
        "dependents": {
          "allow": []
        }
      },
      "test": {
        "dependents": {
          "allow": ["test"]
        }
      },
      "ui": {
        "dependencies": {
          "deny": ["app", "example", "test", "next-config"]
        },
        "dependents": {
          "allow": ["app"]
        }
      }
    }
  },
  "tasks": {
    "typegen": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/*.mdx",
        "!tests/**",
        "!**/*.test.*"
      ],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/*.mdx",
        "!tests/**",
        "!**/*.test.*",
        "!vitest.config.*",
        "!playwright.config.*"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        ".source/**"
      ],
      "env": ["NEXT_PUBLIC_*", "NODE_ENV", "SENTRY_ORG", "SENTRY_PROJECT"],
      "passThroughEnv": ["SENTRY_AUTH_TOKEN"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/*.mdx"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/turbo.json",
        "!**/*.md",
        "!**/*.mdx"
      ]
    },
    "//#lint:root": {
      "inputs": ["*.config.ts", "knip.mts", "scripts/**"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "//#authzen:vectors": {
      "inputs": ["scripts/fetch-authzen-vectors.ts"],
      "outputs": ["packages/permdock/tests/testing/fixtures/authzen/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["DEMO_LATENCY_MS"],
      "passThroughEnv": ["DOCKER_HOST", "TESTCONTAINERS_*"]
    },
    "size": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "gen:check": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "doctor": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "check:publish": {
      "dependsOn": ["build", "^build"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "//#typecheck:tooling": {
      "inputs": ["tsconfig.json", "*.config.ts", "knip.mts", "scripts/**"],
      "outputs": []
    },
    "//#typecheck:perf": {
      "dependsOn": ["permdock#build"],
      "inputs": [
        "scripts/typecheck-perf.*",
        "packages/permdock/tsconfig.json",
        "packages/permdock/src/**",
        "packages/permdock/tests/**"
      ],
      "outputs": [],
      "env": ["CI"]
    },
    "//#cli:startup": {
      "dependsOn": ["permdock#build"],
      "inputs": ["scripts/cli-startup.*", "packages/permdock/src/cli/**"],
      "outputs": [],
      "env": ["CI"]
    },
    "//#knip": {
      "dependsOn": [
        "@permdock/example-prisma#typegen",
        "@permdock/example-react-router#typegen"
      ],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "//#docs:drift": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "//#openapi:check": {
      "inputs": [
        "scripts/fetch-openapi-schemas.ts",
        "oxfmt.config.ts",
        "packages/permdock/schemas/openapi/**"
      ],
      "outputs": []
    },
    "//#audit:high": {
      "cache": false
    },
    "analyze": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["HOST", "PORT"]
    },
    "dev:portless": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["HOST", "PORT"]
    }
  }
}
