{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": true,
  "futureFlags": {
    "globalConfiguration": true,
    "errorsOnlyShowHash": true,
    "longerSignatureKey": true,
    "affectedUsingTaskInputs": true
  },
  "global": {
    "envMode": "strict",
    "cacheMaxAge": "14d",
    "remoteCache": {
      "enabled": true,
      "signature": true
    },
    "env": ["CI", "NODE_ENV"],
    "passThroughEnv": [
      "COREPACK_HOME",
      "ENABLE_EXPERIMENTAL_COREPACK",
      "GITHUB_ACTIONS",
      "INIT_CWD",
      "LEFTHOOK",
      "PORTLESS*",
      "REUI_LICENSE_KEY",
      "VERCEL",
      "VERCEL_*"
    ],
    "inputs": ["packages/typescript-config/*.json", "packages/ox-config/src/**"]
  },
  "boundaries": {
    "tags": {
      "library": {
        "dependencies": {
          "allow": ["library", "config"]
        }
      },
      "app": {
        "dependencies": {
          "allow": ["library", "config", "ui", "next-config"]
        }
      },
      "example": {
        "dependencies": {
          "allow": ["library", "config"]
        },
        "dependents": {
          "allow": ["test"]
        }
      },
      "test": {
        "dependents": {
          "allow": ["test"]
        }
      }
    }
  },
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typegen": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        ".source/**"
      ],
      "env": [
        "MEMBERSHIP_MODE",
        "NEXT_E2E",
        "PERMDOCK_COLLECT",
        "PERMDOCK_E2E_DRIFT",
        "PERMDOCK_E2E_NO_PRIVATE_CACHE",
        "SESSION_SECRET"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build", "typegen"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/turbo.json"]
    },
    "test": {
      "dependsOn": ["build", "^build"]
    },
    "check:publish": {
      "dependsOn": ["build", "^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["HOST", "PORT"]
    },
    "dev:portless": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["HOST", "PORT"]
    }
  }
}
