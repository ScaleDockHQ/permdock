{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": true,
  "futureFlags": {
    "globalConfiguration": true,
    "errorsOnlyShowHash": true,
    "longerSignatureKey": true,
    "affectedUsingTaskInputs": true
  },
  "global": {
    "envMode": "strict",
    "cacheMaxAge": "14d",
    "remoteCache": {
      "enabled": true,
      "signature": true
    },
    "env": ["CI", "NODE_ENV"],
    "passThroughEnv": [
      "COREPACK_HOME",
      "ENABLE_EXPERIMENTAL_COREPACK",
      "INIT_CWD",
      "LEFTHOOK"
    ]
  },
  "boundaries": {
    "tags": {
      "package": {
        "dependencies": {
          "allow": ["package"]
        }
      }
    }
  },
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typegen": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/typescript-config/*.json"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": [
        "MEMBERSHIP_MODE",
        "NEXT_E2E",
        "PERMDOCK_COLLECT",
        "PERMDOCK_E2E_DRIFT",
        "PERMDOCK_E2E_NO_PRIVATE_CACHE",
        "SESSION_SECRET"
      ],
      "passThroughEnv": ["VERCEL", "VERCEL_*"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/typescript-config/*.json"
      ]
    },
    "lint": {
      "dependsOn": ["^build", "typegen"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/ox-config/src/**",
        "$TURBO_ROOT$/turbo.json"
      ]
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/typescript-config/*.json"
      ]
    },
    "check:publish": {
      "dependsOn": ["build", "^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["HOST", "PORT"]
    }
  }
}
