{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": true,
  "futureFlags": {
    "globalConfiguration": true,
    "affectedUsingTaskInputs": true,
    "filterUsingTasks": true,
    "watchUsingTaskInputs": true,
    "pruneIncludesGlobalFiles": true,
    "githubActionsRemoteBaseRefFallback": true,
    "errorsOnlyShowHash": true,
    "longerSignatureKey": true
  },
  "global": {
    "envMode": "strict",
    "cacheMaxAge": "14d",
    "cacheMaxSize": "10GB",
    "remoteCache": {
      "enabled": true,
      "signature": true
    },
    "env": ["CI", "NODE_ENV"],
    "passThroughEnv": [
      "COREPACK_HOME",
      "ENABLE_EXPERIMENTAL_COREPACK",
      "GITHUB_ACTIONS",
      "INIT_CWD",
      "LEFTHOOK",
      "PORTLESS*",
      "REUI_LICENSE_KEY",
      "TURBO_REMOTE_CACHE_SIGNATURE_KEY",
      "VERCEL",
      "VERCEL_*"
    ],
    "inputs": [
      "packages/typescript-config/*.json",
      "packages/ox-config/src/**",
      "pnpm-workspace.yaml"
    ]
  },
  "boundaries": {
    "tags": {
      "library": {
        "dependencies": {
          "allow": ["library", "tooling"]
        }
      },
      "app": {
        "dependencies": {
          "allow": ["library", "tooling", "ui", "next-config"]
        }
      },
      "example": {
        "dependencies": {
          "allow": ["library", "tooling"]
        },
        "dependents": {
          "allow": []
        }
      },
      "test": {
        "dependents": {
          "allow": ["test"]
        }
      },
      "ui": {
        "dependencies": {
          "deny": ["app", "example", "test", "next-config"]
        },
        "dependents": {
          "allow": ["app"]
        }
      }
    }
  },
  "tasks": {
    "typegen": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build", "typegen"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        ".source/**"
      ],
      "env": [
        "DOCS_ORIGIN",
        "NEXT_PUBLIC_*",
        "PERMDOCK_COLLECT",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SESSION_SECRET"
      ],
      "passThroughEnv": ["SENTRY_AUTH_TOKEN"]
    },
    "typecheck": {
      "dependsOn": ["^build", "typegen"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "lint": {
      "dependsOn": ["^build", "typegen"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/turbo.json"]
    },
    "//#lint:root": {
      "inputs": ["*.config.ts", "knip.mts", "scripts/**"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "size": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "gen:check": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "doctor": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "check:publish": {
      "dependsOn": ["build", "^build"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "//#typecheck:tooling": {
      "inputs": ["tsconfig.json", "*.config.ts", "knip.mts", "scripts/**"],
      "outputs": []
    },
    "//#typecheck:perf": {
      "dependsOn": ["permdock#build"],
      "inputs": [
        "scripts/typecheck-perf.*",
        "packages/permdock/tsconfig.json",
        "packages/permdock/src/**",
        "packages/permdock/tests/**"
      ],
      "outputs": []
    },
    "//#knip": {
      "dependsOn": ["@permdock/example-prisma#typegen"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "//#docs:drift": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "//#openapi:check": {
      "inputs": [
        "scripts/fetch-openapi-schemas.ts",
        "packages/permdock/schemas/openapi/**"
      ],
      "outputs": []
    },
    "//#audit:high": {
      "cache": false
    },
    "analyze": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["HOST", "PORT"]
    },
    "dev:portless": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["HOST", "PORT"]
    }
  }
}
