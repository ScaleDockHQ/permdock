{
  "name": "@permdock/monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "analyze": "env -u TURBO_CACHE_DIR turbo run analyze",
    "audit:high": "pnpm audit --audit-level high",
    "authzen:vectors": "node scripts/fetch-authzen-vectors.ts",
    "bench": "pnpm --filter permdock bench",
    "bench:runtime": "node scripts/runtime-perf.ts",
    "bench:scale": "node scripts/scale-bench.ts",
    "boundaries": "turbo boundaries",
    "build": "env -u TURBO_CACHE_DIR turbo run build",
    "changeset": "changeset",
    "check": "pnpm run format:check && pnpm run lint:root && env -u TURBO_CACHE_DIR turbo run lint typecheck typecheck:tooling",
    "check:affected": "env -u TURBO_CACHE_DIR TURBO_SCM_BASE=origin/main turbo run lint:root lint typecheck --affected --cache=local:rw,remote:r --output-logs=errors-only --continue=dependencies-successful",
    "check:publish": "env -u TURBO_CACHE_DIR turbo run check:publish",
    "cli:startup": "node scripts/cli-startup.ts",
    "dev": "turbo run dev --filter=marketing --filter=docs",
    "dev:cleanup": "portless prune",
    "dev:docs": "turbo run dev --filter=docs",
    "dev:marketing": "turbo run dev --filter=marketing --filter=docs",
    "dev:portless": "dotenv -e .env.development.local -e .env.local -- turbo run dev:portless --filter=marketing --filter=docs",
    "docs:drift": "node scripts/check-docs-drift.ts",
    "doctor": "env -u TURBO_CACHE_DIR turbo run doctor",
    "env:pull": "vercel env pull .env.local --environment=development --yes",
    "env:pull:production": "vercel env pull .env.production.local --environment=production --yes",
    "fix": "oxfmt . && pnpm run lint:root --fix && env -u TURBO_CACHE_DIR turbo run lint -- --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "gen:check": "env -u TURBO_CACHE_DIR turbo run gen:check",
    "generate:perf": "node scripts/generate-perf.ts",
    "knip": "knip --config knip.mts --cache",
    "lint": "pnpm run lint:root && env -u TURBO_CACHE_DIR turbo run lint",
    "lint:root": "oxlint commitlint.config.ts knip.mts oxfmt.config.ts oxlint.config.ts scripts vitest.config.ts",
    "openapi:check": "node scripts/fetch-openapi-schemas.ts --check",
    "openapi:generate": "node scripts/fetch-openapi-schemas.ts",
    "permdock": "node packages/permdock/dist/cli/bin.js",
    "prepare": "node scripts/prepare.ts",
    "release": "node scripts/publish.ts",
    "rls-bench": "env -u TURBO_CACHE_DIR turbo run rls-bench",
    "runtime:perf": "node scripts/runtime-perf.ts --check",
    "size": "env -u TURBO_CACHE_DIR turbo run size",
    "standards:fixtures": "node scripts/fetch-standards-fixtures.ts && oxfmt packages/permdock/tests/fixtures/standards",
    "supabase:prune": "node scripts/supabase-prune.ts",
    "test": "env -u TURBO_CACHE_DIR turbo run test",
    "test:e2e": "env -u TURBO_CACHE_DIR turbo run test:e2e --concurrency=1",
    "test:integration": "pnpm --filter @permdock/integration test:integration",
    "test:runtimes": "pnpm --filter @permdock/runtimes test:runtimes",
    "typecheck": "env -u TURBO_CACHE_DIR turbo run typecheck",
    "typecheck:perf": "node scripts/typecheck-perf.ts",
    "typecheck:tooling": "tsc --noEmit",
    "verify": "pnpm run format:check && pnpm run lint:root && pnpm run boundaries && env -u TURBO_CACHE_DIR turbo run --continue=dependencies-successful lint typecheck typecheck:compat typecheck:tooling knip test size docs:drift openapi:check gen:check doctor check:publish typecheck:perf generate:perf rls-bench cli:startup audit:high && env -u TURBO_CACHE_DIR turbo run runtime:perf --concurrency=1",
    "version-packages": "node scripts/root-changelog.ts && changeset version && node scripts/sync-server-version.ts && node scripts/sync-generated-version.ts && oxfmt .",
    "worktree:setup": "node scripts/worktree-setup.ts"
  },
  "devDependencies": {
    "@changesets/assemble-release-plan": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@changesets/config": "catalog:",
    "@changesets/pre": "catalog:",
    "@changesets/read": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@manypkg/get-packages": "catalog:",
    "@permdock/typescript-config": "workspace:*",
    "@shadcn/lint": "catalog:",
    "@types/node": "catalog:",
    "dotenv-cli": "catalog:",
    "eslint-plugin-turbo": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-plugin-react-doctor": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "portless": "catalog:",
    "supports-color": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.x",
    "pnpm": "12.18.0"
  },
  "packageManager": "pnpm@12.18.0"
}
