{
  "name": "@permdock/monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "authzen:vectors": "node scripts/fetch-authzen-vectors.ts",
    "build": "turbo run build",
    "changeset": "changeset",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck",
    "check:publish": "turbo run check:publish",
    "docs:dev": "turbo run dev --filter=docs",
    "docs:drift": "node scripts/check-docs-drift.ts",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "pnpm run lint:root && turbo run lint",
    "lint:root": "oxlint commitlint.config.ts oxfmt.config.ts oxlint.config.ts scripts",
    "marketing:dev": "turbo run dev --filter=marketing --filter=docs",
    "permdock": "permdock",
    "prepare": "node scripts/prepare.mjs",
    "size": "pnpm --filter @permdock/bundle test",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @permdock/e2e test:e2e",
    "test:integration": "pnpm --filter @permdock/integration test:integration",
    "test:runtimes": "pnpm --filter @permdock/runtimes test:runtimes",
    "typecheck": "turbo run typecheck",
    "typecheck:tooling": "tsc --noEmit --checkers 4"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@permdock/ox-config": "workspace:*",
    "@permdock/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "permdock": "workspace:*",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.x",
    "pnpm": "12.8.1"
  },
  "packageManager": "pnpm@12.8.1"
}
