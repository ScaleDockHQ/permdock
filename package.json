{
  "name": "@permdock/monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "audit:high": "pnpm audit --audit-level high",
    "authzen:vectors": "node scripts/fetch-authzen-vectors.ts",
    "boundaries": "turbo boundaries",
    "build": "turbo run build",
    "changeset": "changeset",
    "check:publish": "turbo run check:publish",
    "dev": "turbo run dev --filter=marketing --filter=docs",
    "dev:cleanup": "portless prune",
    "dev:portless": "dotenv -e .env.local -e .env.development.local -- turbo run dev:portless --filter=marketing --filter=docs",
    "docs:dev": "turbo run dev --filter=docs",
    "docs:drift": "node scripts/check-docs-drift.ts",
    "env:pull": "vercel env pull .env.development.local --environment=development --yes && vercel env pull .env.preview.local --environment=preview --yes && vercel env pull .env.production.local --environment=production --yes",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "turbo run typegen --filter=@permdock/e2e-sveltekit-saas --filter=@permdock/e2e-nuxt-saas --filter=@permdock/e2e-tanstack-start-saas --filter=@permdock/example-prisma && knip --config knip.mts",
    "lint": "pnpm run lint:root && turbo run lint",
    "lint:root": "oxlint commitlint.config.ts oxfmt.config.ts oxlint.config.ts scripts vitest.config.ts",
    "marketing:dev": "turbo run dev --filter=marketing --filter=docs",
    "openapi:generate": "node scripts/fetch-openapi-schemas.ts && oxfmt packages/permdock/schemas/openapi",
    "permdock": "permdock",
    "prepare": "node scripts/prepare.mjs",
    "release": "node scripts/publish.ts",
    "size": "pnpm --filter @permdock/bundle test",
    "standards:fixtures": "node scripts/fetch-standards-fixtures.ts && oxfmt packages/permdock/tests/fixtures/standards",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @permdock/e2e test:e2e",
    "test:integration": "pnpm --filter @permdock/integration test:integration",
    "test:runtimes": "pnpm --filter @permdock/runtimes test:runtimes",
    "typecheck": "turbo run typecheck",
    "typecheck:perf": "node scripts/typecheck-perf.ts",
    "typecheck:tooling": "tsc --noEmit --checkers 4",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run typecheck:tooling && pnpm run knip && pnpm run boundaries && pnpm run test && pnpm run docs:drift",
    "version-packages": "node scripts/root-changelog.ts && changeset version && oxfmt ."
  },
  "devDependencies": {
    "@changesets/assemble-release-plan": "catalog:",
    "@changesets/cli": "catalog:",
    "@changesets/config": "catalog:",
    "@changesets/pre": "catalog:",
    "@changesets/read": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@manypkg/get-packages": "catalog:",
    "@permdock/ox-config": "workspace:*",
    "@permdock/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "dotenv-cli": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "permdock": "workspace:*",
    "portless": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.x",
    "pnpm": "12.8.1"
  },
  "packageManager": "pnpm@12.8.1"
}
