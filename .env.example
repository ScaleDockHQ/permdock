# Keys only. `pnpm env:pull` writes .env.development.local, .env.preview.local
# and .env.production.local from Vercel; `pnpm dev:portless` loads .env.local
# and .env.development.local. Build, verify and test need none of these.

# Public origin every absolute URL derives from. Default: https://permdock.dev
NEXT_PUBLIC_SITE_URL=

# Sentry runs only in production builds with a DSN. Source maps upload only on
# Vercel production builds, with the org, project and auth token set.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Marketing proxies /docs here in development. `pnpm dev:portless` sets it to
# the docs Portless URL. Default: http://127.0.0.1:3001
DOCS_ORIGIN=

# Premium ReUI registry items for the shadcn CLI (apps/marketing/components.json).
REUI_LICENSE_KEY=
