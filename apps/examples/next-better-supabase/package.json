{
  "name": "@permdock/example-next-better-supabase",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../../scripts/next-build.ts",
    "dev": "next dev -p 3489 -H 127.0.0.1",
    "doctor": "permdock doctor && permdock supabase inspect --check && node scripts/better-supabase.ts doctor",
    "gen": "permdock generate --only rls && permdock supabase inspect --out && node scripts/better-supabase.ts gen",
    "gen:check": "permdock generate --only rls --check && permdock supabase inspect --check && permdock openapi emit --doc openapi.json --kind overlay --out openapi.overlay.json --check && better-supabase upgrade --check && node scripts/better-supabase.ts gen --check",
    "lint": "next typegen && oxlint --disable-nested-config --type-aware",
    "serve": "node scripts/serve.ts",
    "sql:regenerate": "better-supabase upgrade",
    "start": "next start -p 3489 -H 127.0.0.1",
    "supabase:check": "supabase db lint -s public,permdock,tests --fail-on warning && supabase db advisors --local --fail-on warn && permdock doctor && permdock rls verify --introspect --helpers-only --local && node scripts/stack-db-url.ts | better-supabase doctor --fail-on warning --db-url-stdin",
    "supabase:diff": "supabase db schema declarative sync --no-apply -f",
    "supabase:start": "supabase start --runtime native",
    "supabase:stop": "supabase stop",
    "supabase:test": "supabase test db",
    "test": "vitest run --exclude 'tests/stack/**'",
    "test:e2e": "playwright test",
    "test:stack": "vitest run tests/stack",
    "typecheck": "next typegen && tsc --noEmit",
    "typegen": "next typegen"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@dnd-kit/core": "catalog:",
    "@dnd-kit/modifiers": "catalog:",
    "@dnd-kit/sortable": "catalog:",
    "@dnd-kit/utilities": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "better-supabase": "catalog:",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "date-fns": "catalog:",
    "jose": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "permdock": "workspace:*",
    "pg": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:",
    "shadcn": "catalog:",
    "tw-animate-css": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@next/playwright": "catalog:",
    "@permdock/typescript-config": "workspace:*",
    "@playwright/test": "catalog:",
    "@supabase/postgrest-typegen": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "better-result": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "postcss": "catalog:",
    "supabase": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vitest": "catalog:"
  }
}
