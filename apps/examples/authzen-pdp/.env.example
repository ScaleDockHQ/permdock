# Keys only. Without them the parity test runs the PEP against the local PDP
# alone. Every PERMDOCK_CLOUD_* key comes from the environment's dashboard.

# The Cloud origin and environment; the PEP calls <url>/v1/environments/<env>.
PERMDOCK_CLOUD_URL=
PERMDOCK_CLOUD_ENV=

# OAuth client credentials of a client registered as a trusted PEP
# (`/trusted-peps` with `{ client_id }`).
PERMDOCK_CLOUD_CLIENT_ID=
PERMDOCK_CLOUD_CLIENT_SECRET=

# With all three set, the parity test also runs testCloudApi: the `client` key,
# and a private ES256 JWK whose issuer is a trusted issuer of the environment.
PERMDOCK_CLOUD_KEY=
PERMDOCK_CLOUD_APPROVER_JWK=
PERMDOCK_CLOUD_APPROVER_ISSUER=
