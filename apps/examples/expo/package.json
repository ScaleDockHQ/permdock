{
  "name": "@permdock/example-expo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --web --port 3486",
    "doctor": "permdock doctor",
    "gen": "node scripts/manifest.ts",
    "gen:check": "node scripts/manifest.ts --check",
    "lint": "oxlint --disable-nested-config --type-aware",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts"
  },
  "dependencies": {
    "@expo/log-box": "catalog:",
    "@expo/metro-runtime": "catalog:",
    "@react-native/metro-config": "catalog:",
    "babel-preset-expo": "catalog:",
    "expo": "catalog:",
    "expo-constants": "catalog:",
    "expo-linking": "catalog:",
    "expo-modules-core": "catalog:",
    "expo-router": "catalog:",
    "expo-secure-store": "catalog:",
    "permdock": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "react-native-web": "catalog:",
    "react-native-worklets": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@permdock/ox-config": "workspace:*",
    "@permdock/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  }
}
