{
  "name": "@permdock/example-prisma",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && node --watch --experimental-strip-types src/serve.ts",
    "doctor": "permdock doctor",
    "lint": "oxlint --disable-nested-config --type-aware",
    "start": "prisma generate && node --experimental-strip-types src/serve.ts",
    "typecheck": "tsc --noEmit",
    "typegen": "prisma generate"
  },
  "dependencies": {
    "@electric-sql/pglite": "catalog:",
    "@electric-sql/pglite-socket": "catalog:",
    "@hono/node-server": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "hono": "catalog:",
    "permdock": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@permdock/ox-config": "workspace:*",
    "@permdock/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prisma": "catalog:",
    "typescript": "catalog:"
  }
}
