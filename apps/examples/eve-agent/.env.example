# Keys only. Without PERMDOCK_CLOUD_URL and PERMDOCK_CLOUD_KEY the app keeps
# approvals in memory. The Vercel Marketplace integration writes both; the
# production URL is https://permdock.com/api.
PERMDOCK_CLOUD_URL=
PERMDOCK_CLOUD_KEY=
# Optional; without it the Cloud names the key's environment.
PERMDOCK_CLOUD_ENV=

# The webhook connector's `whsec_` secret, for `v1` signatures on
# POST /webhooks/permdock. `v1a` signatures verify against the environment JWKS.
PERMDOCK_CLOUD_WEBHOOK_SECRET=

# A private ES256 JWK and its issuer, registered as a trusted issuer, so
# POST /approve can resolve in the Cloud. Without them, approve in the inbox.
PERMDOCK_CLOUD_APPROVER_JWK=
PERMDOCK_CLOUD_APPROVER_ISSUER=
