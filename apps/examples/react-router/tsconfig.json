{
  "extends": "@permdock/typescript-config/base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "rootDirs": [".", "./.react-router/types"],
    "types": ["@react-router/node", "vite/client"]
  },
  "include": [
    "app",
    "react-router.config.ts",
    "vite.config.ts",
    ".react-router/types/**/*"
  ]
}
