{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tags": ["app"],
  "tasks": {
    "build": {
      "dependsOn": ["$TURBO_EXTENDS$", "typegen"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/vercel.json",
        "$TURBO_ROOT$/packages/permdock/CHANGELOG.md"
      ],
      "env": ["$TURBO_EXTENDS$", "DOCS_ORIGIN", "EXPOSE_TESTING_API"]
    },
    "dev": {
      "passThroughEnv": ["PORT", "DOCS_ORIGIN"]
    },
    "lint": {
      "dependsOn": ["$TURBO_EXTENDS$", "typegen"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["build", "^build"]
    }
  }
}
