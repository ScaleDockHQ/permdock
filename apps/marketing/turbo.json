{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tags": ["app"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vercel.json"],
      "env": ["$TURBO_EXTENDS$", "DOCS_ORIGIN", "EXPOSE_TESTING_API"]
    },
    "dev": {
      "passThroughEnv": ["PORT", "DOCS_ORIGIN"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["build", "^build"]
    }
  }
}
