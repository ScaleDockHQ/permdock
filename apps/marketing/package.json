{
  "name": "marketing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev -p ${PORT:-3000}",
    "dev:portless": "DOCS_ORIGIN=$(portless get docs.permdock) portless",
    "lint": "oxlint --disable-nested-config --type-aware",
