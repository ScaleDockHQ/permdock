{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@permdock/typescript-config/next.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "isolatedDeclarations": false,
    "skipLibCheck": true,
    "paths": {
      "@/components/ui/*": ["../../../packages/ui/src/components/*"],
      "@/lib/utils": ["../../../packages/ui/src/lib/utils"],
      "@permdock/ui/*": ["../../../packages/ui/src/*"]
    }
  },
  "include": ["permdock/**/*.tsx"]
}
