{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@permdock/typescript-config/next.json",
  "compilerOptions": {
    // Vendored ReUI and block components are checked through their imports and
    // do not compile under these flags; see docs/decisions.
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "declaration": false,
    "isolatedDeclarations": false,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "components/blocks", "components/examples"]
}
