{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@permdock/typescript-config/next.json",
  "compilerOptions": {
    "declaration": false,
    "isolatedDeclarations": false,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "verbatimModuleSyntax": false,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "components/ui",
    "components/reui",
    "components/blocks",
    "components/examples"
  ]
}
