{
  "extends": "@permdock/typescript-config/base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "declaration": false,
    "isolatedDeclarations": false,
    "jsx": "react-jsx",
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src", "scripts"]
}
