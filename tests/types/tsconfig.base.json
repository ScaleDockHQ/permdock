{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["ES2022", "ESNext", "DOM"],
    "noEmit": true,
    "declaration": true,
    "skipLibCheck": false,
    "verbatimModuleSyntax": true,
    "exactOptionalPropertyTypes": true
  }
}
