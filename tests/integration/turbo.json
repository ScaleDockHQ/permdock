{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tags": ["test"],
  "tasks": {
    "test:integration": {
      "env": [
        "PERMDOCK_POSTGRES_BIN",
        "PERMDOCK_SCALE",
        "PERMDOCK_SCALE_TIER",
        "PERMDOCK_SCALE_TIMEOUT_MS",
        "PERMDOCK_SCALE_WRITE"
      ]
    },
    "typecheck": {
      "dependsOn": ["$TURBO_EXTENDS$", "typegen"]
    },
    "lint": {
      "dependsOn": ["$TURBO_EXTENDS$", "typegen"]
    },
    "typegen": {
      "dependsOn": ["$TURBO_EXTENDS$"],
      "outputs": ["src/support/prisma/**"]
    }
  }
}
