{
  "$schema": "https://permdock.com/schemas/supabase-manifest-v1.json",
  "version": 1,
  "hook": {
    "schema": "permdock",
    "function": "custom_access_token_hook",
    "out": "supabase/schemas/permdock/functions/custom_access_token_hook.sql",
    "activeFrom": {
      "appMetadata": "tenant_id"
    },
    "schemas": "pg-delta"
  },
  "helpers": {
    "schema": "permdock",
    "functions": [
      "permdock_has",
      "permitted_organization_ids",
      "member_organization_ids",
      "member_organization_ids_for"
    ]
  },
  "tenantClaim": "tenant_id",
  "budget": {
    "bytes": 1024,
    "measure": "octet_length(roles::text) + octet_length(user_role::text) + octet_length(memberships::text) + octet_length(team_ids::text) + octet_length(attrs::text) + octet_length(active_tenant::text) + 20 + octet_length(authz_ver::text)"
  },
  "claims": [
    {
      "name": "user_role",
      "source": "permdock",
      "budget": false
    },
    {
      "name": "roles",
      "source": "permdock",
      "budget": true
    },
    {
      "name": "memberships",
      "source": "permdock",
      "budget": true
    },
    {
      "name": "memberships_truncated",
      "source": "permdock",
      "budget": false
    },
    {
      "name": "tenant_id",
      "source": "permdock",
      "budget": false
    },
    {
      "name": "authz_ver",
      "source": "permdock",
      "budget": true
    }
  ],
  "authzVersion": true,
  "authzVersionBump": {
    "schema": "permdock",
    "function": "permdock_bump_authz_version_for",
    "args": "p_users uuid[]"
  },
  "memberships": [
    {
      "table": "public.memberships",
      "user": {
        "column": "user_id"
      },
      "scope": {
        "column": "scope"
      },
      "id": {
        "column": "scope_id"
      },
      "role": {
        "column": "role"
      },
      "columns": ["user_id", "scope", "scope_id", "role"]
    }
  ],
  "rls": {
    "schema": "permdock",
    "mode": "database",
    "tenantClaim": "tenant_id",
    "scopes": [
      {
        "name": "organization",
        "type": "text"
      }
    ],
    "helpers": [
      {
        "name": "permdock_has",
        "args": "p_grant text",
        "returns": "boolean",
        "execute": ["authenticated"]
      },
      {
        "name": "permitted_organization_ids",
        "args": "p_grant text",
        "returns": "setof text",
        "execute": ["authenticated"]
      },
      {
        "name": "member_organization_ids",
        "args": "",
        "returns": "setof text",
        "execute": ["authenticated"]
      },
      {
        "name": "member_organization_ids_for",
        "args": "p_user uuid",
        "returns": "setof text",
        "execute": []
      },
      {
        "name": "permdock_user_id",
        "args": "",
        "returns": "uuid",
        "execute": ["authenticated"]
      },
      {
        "name": "permdock_subject",
        "args": "",
        "returns": "jsonb",
        "execute": ["authenticated"]
      },
      {
        "name": "permdock_subject",
        "args": "p_tenant text",
        "returns": "jsonb",
        "execute": ["authenticated"]
      },
      {
        "name": "permdock_bootstrap_permissions",
        "args": "p_tenant text",
        "returns": "jsonb",
        "execute": ["authenticated"]
      },
      {
        "name": "permdock_is_approver",
        "args": "p_approvers jsonb, p_tenant text, p_requester text, p_resource text",
        "returns": "boolean",
        "execute": ["authenticated"]
      },
      {
        "name": "permdock_approver_for_ids",
        "args": "",
        "returns": "setof uuid",
        "execute": ["authenticated"]
      },
      {
        "name": "permdock_manages",
        "args": "p_requester text, p_levels integer",
        "returns": "boolean",
        "execute": []
      },
      {
        "name": "permdock_managed_user_ids",
        "args": "p_tenant text",
        "returns": "setof uuid",
        "execute": ["authenticated"]
      },
      {
        "name": "permdock_has_for",
        "args": "p_user uuid, p_grant text",
        "returns": "boolean",
        "execute": []
      },
      {
        "name": "permitted_organization_ids_for",
        "args": "p_user uuid, p_grant text",
        "returns": "setof text",
        "execute": []
      },
      {
        "name": "permitted_organization_permission_keys_for",
        "args": "p_user uuid, p_id text",
        "returns": "setof text",
        "execute": []
      },
      {
        "name": "permitted_organization_users",
        "args": "p_permission text, p_id text",
        "returns": "setof uuid",
        "execute": []
      },
      {
        "name": "permdock_can_assign",
        "args": "p_role text, p_scope_id text",
        "returns": "boolean",
        "execute": ["authenticated"]
      },
      {
        "name": "permdock_can_assign_for",
        "args": "p_user uuid, p_role text, p_scope_id text",
        "returns": "boolean",
        "execute": []
      },
      {
        "name": "permdock_can_assign_any",
        "args": "p_role text, p_tenant text, p_scope text, p_scope_id text",
        "returns": "boolean",
        "execute": ["authenticated"]
      },
      {
        "name": "permdock_can_assign_any_for",
        "args": "p_user uuid, p_role text, p_tenant text, p_scope text, p_scope_id text",
        "returns": "boolean",
        "execute": []
      }
    ],
    "memberships": [
      {
        "table": "public.memberships",
        "user": {
          "column": "user_id"
        },
        "scope": {
          "column": "scope"
        },
        "id": {
          "column": "scope_id"
        },
        "role": {
          "column": "role"
        },
        "columns": ["user_id", "scope", "scope_id", "role"]
      }
    ],
    "customRoles": false,
    "roles": {
      "table": "public.platform_roles",
      "user": {
        "column": "user_id"
      },
      "role": {
        "column": "role"
      }
    },
    "suspension": {
      "users": {
        "table": "public.profiles",
        "id": "id",
        "disabledAt": "disabled_at"
      },
      "scopes": {
        "organization": {
          "table": "public.organizations",
          "id": "id",
          "disabledAt": "disabled_at"
        }
      }
    }
  },
  "decidingColumns": [
    "public.memberships.role",
    "public.memberships.scope",
    "public.memberships.scope_id",
    "public.memberships.user_id"
  ],
  "markers": {
    "hook": "v1",
    "grants": "v1"
  },
  "requires": {
    "matrix": "capability-matrix-v1.12.0",
    "capabilities": ["auth.session.get_claims"]
  },
  "names": {
    "schema": "permdock",
    "gucPrefix": "app",
    "claims": {
      "tenant": "tenant_id",
      "role": "user_role"
    },
    "scopes": {
      "organization": {
        "permittedIds": "permitted_organization_ids",
        "permittedIdsFor": "permitted_organization_ids_for",
        "memberIds": "member_organization_ids",
        "memberIdsFor": "member_organization_ids_for",
        "permittedUsers": "permitted_organization_users"
      }
    },
    "resources": {
      "projects": {
        "table": "projects"
      }
    }
  },
  "fixtureRoles": ["member", "owner"],
  "managementApi": {
    "hook_custom_access_token_enabled": true,
    "hook_custom_access_token_uri": "pg-functions://postgres/permdock/custom_access_token_hook",
    "jwt_exp": 3600
  }
}
