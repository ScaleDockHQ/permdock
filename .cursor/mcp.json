{
  "mcpServers": {
    "permdock-docs": {
      "url": "https://permdock.com/mcp"
    },
    "vercel": {
      "url": "https://mcp.vercel.com"
    },
    "shadcn": {
      "command": "pnpm",
      "args": [
        "--dir",
        "apps/marketing",
        "exec",
        "shadcn",
        "mcp"
      ]
    },
    "reui": {
      "url": "https://mcp.reui.io/api/mcp",
      "headers": {
        "Authorization": "Bearer ${env:REUI_LICENSE_KEY}"
      }
    },
    "next-devtools": {
      "command": "pnpm",
      "args": [
        "dlx",
        "next-devtools-mcp@0.4.0"
      ]
    }
  }
}
