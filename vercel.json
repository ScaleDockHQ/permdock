{
  "services": {
    "docs": {
      "root": "apps/docs",
      "framework": "nextjs",
      "installCommand": "corepack enable && corepack prepare pnpm@12.3.1 --activate && corepack pnpm@12.3.1 install",
      "buildCommand": "(cd ../../packages/permdock && node --run build) && next build",
      "rewrites": [
        {
          "source": "/docs/_next/:path*",
          "destination": "/_next/:path*"
        }
      ]
    },
    "marketing": {
      "root": "apps/marketing",
      "framework": "nextjs",
      "installCommand": "corepack enable && corepack prepare pnpm@12.3.1 --activate && corepack pnpm@12.3.1 install",
      "buildCommand": "(cd ../../packages/permdock && node --run build) && next build"
    }
  },
  "rewrites": [
    {
      "source": "/docs",
      "destination": { "service": "docs" }
    },
    {
      "source": "/docs/(.*)",
      "destination": { "service": "docs" }
    },
    {
      "source": "/api/search",
      "destination": { "service": "docs" }
    },
    {
      "source": "/mcp",
      "destination": { "service": "docs" }
    },
    {
      "source": "/devtools",
      "destination": { "service": "docs" }
    },
    {
      "source": "/llms.txt",
      "destination": { "service": "docs" }
    },
    {
      "source": "/llms-full.txt",
      "destination": { "service": "docs" }
    },
    {
      "source": "/llms.mdx/(.*)",
      "destination": { "service": "docs" }
    },
    {
      "source": "/og/(.*)",
      "destination": { "service": "docs" }
    },
    {
      "source": "/_next/(.*)",
      "destination": { "service": "marketing" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "marketing" }
    }
  ]
}
