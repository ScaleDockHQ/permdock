{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "**": false,
      "changeset-release/**": false,
      "main": true
    }
  },
  "services": {
    "docs": {
      "root": "apps/docs",
      "framework": "nextjs",
      "installCommand": "corepack enable && corepack prepare pnpm@12.18.0 --activate && corepack pnpm@12.18.0 install --frozen-lockfile --filter '{.}...' --include-workspace-root",
      "buildCommand": "mkdir -p /tmp/corepack && corepack enable --install-directory /tmp/corepack pnpm && corepack prepare pnpm@12.18.0 --activate && export PATH=\"/tmp/corepack:$PATH\" && corepack pnpm@12.18.0 exec turbo run build --filter=docs",
      "rewrites": [
        {
          "source": "/docs/_next/:path*",
          "destination": "/_next/:path*"
        }
      ]
    },
    "marketing": {
      "root": "apps/marketing",
      "framework": "nextjs",
      "installCommand": "corepack enable && corepack prepare pnpm@12.18.0 --activate && corepack pnpm@12.18.0 install --frozen-lockfile --filter '{.}...' --include-workspace-root",
      "buildCommand": "mkdir -p /tmp/corepack && corepack enable --install-directory /tmp/corepack pnpm && corepack prepare pnpm@12.18.0 --activate && export PATH=\"/tmp/corepack:$PATH\" && corepack pnpm@12.18.0 exec turbo run build --filter=marketing"
    }
  },
  "rewrites": [
    {
      "source": "/docs",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/docs/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/docs.md",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/api/search",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/devtools",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/llms.txt",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/llms-full.txt",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/llms.mdx/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/og/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/149e9513-01fa-4fb0-aad4-566afd725d1b/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": "https://app.permdock.com/api/$1"
    },
    {
      "source": "/mcp",
      "destination": "https://app.permdock.com/mcp"
    },
    {
      "source": "/.well-known/oauth-authorization-server/api",
      "destination": "https://app.permdock.com/.well-known/oauth-authorization-server/api"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "https://app.permdock.com/.well-known/oauth-protected-resource/mcp"
    },
    {
      "source": "/_next/(.*)",
      "destination": {
        "service": "marketing"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "marketing"
      }
    }
  ]
}
