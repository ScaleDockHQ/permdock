{
  "files.exclude": {
    "**/.turbo": true,
    "**/node_modules": true
  },
  "search.exclude": {
    "**/.next": true,
    "**/.source": true,
    "**/.turbo": true,
    "**/coverage": true,
    "**/dist": true,
    "**/next-env.d.ts": true,
    "pnpm-lock.yaml": true
  },
  "files.watcherExclude": {
    "**/.next/**": true,
    "**/.source/**": true,
    "**/.turbo/**": true,
    "**/dist/**": true
  },
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "oxc.configPath": "./oxlint.config.ts",
  "oxc.fmt.configPath": "./oxfmt.config.ts",
  "oxc.typeAware": true,
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "./node_modules/typescript",
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "tailwindCSS.classFunctions": ["cn", "cva", "tv"],
  "tailwindCSS.experimental.configFile": {
    "apps/docs/app/global.css": "apps/docs/**",
    "apps/marketing/app/globals.css": ["apps/marketing/**", "packages/ui/**"]
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  }
}
