{
  "servers": {
    "permdock-docs": {
      "type": "http",
      "url": "https://permdock.dev/mcp"
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    },
    "shadcn": {
      "type": "stdio",
      "command": "pnpm",
      "args": ["--dir", "apps/marketing", "exec", "shadcn", "mcp"]
    },
    "reui": {
      "type": "http",
      "url": "https://mcp.reui.io"
    },
    "next-devtools": {
      "type": "stdio",
      "command": "pnpm",
      "args": ["dlx", "next-devtools-mcp@0.4.0"]
    }
  }
}
